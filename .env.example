# Copy this file to .env and fill in the values. Never upload .env to GitHub.
# Paste the EXTERNAL database URL from Render (starts with postgresql://)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
# Websites allowed to call the API from a browser (used in Activity 8). Comma separated.
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
